; Engine configuration file.
; 《缀》/ actGame —— Q 版像素类银河恶魔城
; 规范来源：docs/02-像素美术规范.md v0.4

config_version=5

[application]

config/name="缀 Ori"
config/description="Q 版像素横版类银河恶魔城动作游戏"
run/main_scene="res://scenes/bootstrap.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=480
window/size/viewport_height=270
window/size/window_width_override=1440
window/size/window_height_override=810
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/stretch/scale_mode="integer"
window/handheld/orientation=1

; Web 导出专用：浏览器窗口尺寸不可控，单位用 viewport 比例而非固定像素
; 否则 1440x810 在小于该尺寸的屏幕上会被裁切
window/size/initial_position_type=0
window/size/resizable=true

[rendering]

textures/canvas_textures/default_texture_filter=0
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
anti_aliasing/quality/msaa_2d=0
renderer/rendering_method="gl_compatibility"
environment/defaults/default_clear_color=Color(0.066667, 0.078431, 0.164706, 1)

[physics]

common/physics_ticks_per_second=120
2d/default_gravity=0.0

[input]

